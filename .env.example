# Gmail account the reminder is sent FROM. Requires 2-Step Verification and an App Password:
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Who gets the reminder (comma-separated). Defaults to GMAIL_ADDRESS.
REMINDER_TO=you@gmail.com

# Time (24h, Pacific) after which a reminder is sent if no form was submitted today.
REMINDER_TIME=21:00

# Link included in the email: use this machine's LAN address so it opens from your phone.
FORM_URL=http://192.168.1.50:8000/
