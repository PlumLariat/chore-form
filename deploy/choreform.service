# systemd unit for the chore form app.
# Edit User and the /opt/choreform paths to match your server, then see README.md "Run as a service".
[Unit]
Description=Chore form web app
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=choreform
WorkingDirectory=/opt/choreform
ExecStart=/opt/choreform/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
